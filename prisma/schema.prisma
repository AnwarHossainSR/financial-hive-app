generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @unique @db.Uuid
  display_name String?
  avatar_url   String?
  email        String?
  role         String   @default("user") @db.VarChar(20)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("profiles")
}

model Book {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  type               BookType            @default(personal)
  owner_id           String              @db.Uuid
  description        String?
  is_default         Boolean             @default(false)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  members            BookMember[]
  transactions       Transaction[]
  monthly_budgets    MonthlyBudget[]
  investmentProjects InvestmentProject[]

  @@map("books")
}

enum BookType {
  personal
  business

  @@map("book_type")
}

model BookMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_id    String   @db.Uuid
  user_id    String   @db.Uuid
  role       AppRole  @default(member)
  invited_by String?  @db.Uuid
  joined_at  DateTime @default(now()) @db.Timestamptz(6)
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, user_id])
  @@map("book_members")
}

enum AppRole {
  owner
  member
  viewer

  @@map("app_role")
}

model Transaction {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_id    String          @db.Uuid
  user_id    String          @db.Uuid
  type       TransactionType
  amount     Decimal         @db.Decimal(15, 2)
  category   String
  note       String?
  date       DateTime        @default(now()) @db.Timestamptz(6)
  image_url  String?
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @db.Timestamptz(6)
  book       Book            @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  income
  expense

  @@map("transaction_type")
}

model MonthlyBudget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_id    String   @db.Uuid
  month      String   @db.VarChar(7)
  amount     Decimal  @db.Decimal(15, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, month])
  @@map("monthly_budgets")
}

model UserSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @unique @db.Uuid
  default_book_id String?  @db.Uuid
  notifications   Json     @default("{\"transactions\": true, \"books\": true, \"reports\": false, \"email\": true}")
  export_format   String   @default("csv") @db.VarChar(10)
  currency        String   @default("USD") @db.VarChar(3)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("user_settings")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  title      String
  message    String
  type       NotificationType @default(info)
  read       Boolean          @default(false)
  metadata   Json?            @default("{}")
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @default(now()) @db.Timestamptz(6)

  @@map("notifications")
}

enum NotificationType {
  info
  success
  warning
  error

  @@map("notification_type")
}

model InvestmentProject {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String              @db.Uuid
  name              String
  description       String?
  total_profit      Decimal             @default(0) @db.Decimal(15, 2)
  total_loss        Decimal             @default(0) @db.Decimal(15, 2)
  total_profit_loss Decimal             @default(0) @db.Decimal(15, 2)
  remaining_capital Decimal             @default(0) @db.Decimal(15, 2)
  total_investment  Decimal             @default(0) @db.Decimal(15, 2)
  status            ProjectStatus       @default(active)
  start_date        DateTime            @default(now()) @db.Timestamptz(6)
  end_date          DateTime?           @db.Timestamptz(6)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  entries           InvestmentEntry[]
  bank_statements   BankStatement[]
  book              Book?               @relation(fields: [bookId], references: [id])
  bookId            String?             @db.Uuid
  platform_id       String?             @db.Uuid
  platform          InvestmentPlatform? @relation(fields: [platform_id], references: [id], onDelete: SetNull)

  @@map("investment_projects")
}

model InvestmentPlatform {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String              @db.Uuid
  name        String
  description String?
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime            @default(now()) @db.Timestamptz(6)
  projects    InvestmentProject[]

  @@map("investment_platforms")
}

enum ProjectStatus {
  active
  completed
  paused

  @@map("project_status")
}

model InvestmentEntry {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id      String      @db.Uuid
  user_id         String      @db.Uuid
  date            DateTime    @db.Timestamptz(6)
  investment_type String
  amount          Decimal     @db.Decimal(15, 2)
  status          EntryStatus @default(pending)
  principal       Decimal?    @db.Decimal(15, 2)
  expected_profit Decimal?    @db.Decimal(15, 2)
  profit_received Decimal?    @default(0) @db.Decimal(15, 2)
  withdrawal_amount Decimal?  @db.Decimal(15, 2)
  profit_loss     Decimal?    @db.Decimal(15, 2)
  withdrawal_date DateTime?   @db.Timestamptz(6)
  notes           String?
  image_url       String?
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)
  project         InvestmentProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("investment_entries")
}

enum EntryStatus {
  pending
  active
  completed
  withdrawn

  @@map("entry_status")
}

model BankStatement {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id       String            @db.Uuid
  user_id          String            @db.Uuid
  date             DateTime          @db.Timestamptz(6)
  total_capital    Decimal           @db.Decimal(15, 2)
  total_withdrawal Decimal           @db.Decimal(15, 2)
  balance          Decimal           @db.Decimal(15, 2)
  notes            String?
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  project          InvestmentProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@map("bank_statements")
}
