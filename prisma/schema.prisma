generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id              String    @id @db.Uuid
  full_name       String?
  avatar_url      String?
  is_system_admin Boolean   @default(false)
  updated_at      DateTime? @db.Timestamptz(6)
  email           String?

  @@map("profiles")
}

model Book {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  type            BookType        @default(personal)
  owner_id        String          @db.Uuid
  description     String?
  is_default      Boolean         @default(false)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  members         BookMember[]
  transactions    Transaction[]
  monthly_budgets MonthlyBudget[]

  @@map("books")
}

enum BookType {
  personal
  business
}

model BookMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_id    String   @db.Uuid
  user_id    String   @db.Uuid
  role       AppRole  @default(member)
  invited_by String?  @db.Uuid
  joined_at  DateTime @default(now()) @db.Timestamptz(6)
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, user_id])
  @@map("book_members")
}

enum AppRole {
  owner
  member
  viewer
}

model Transaction {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_id    String          @db.Uuid
  user_id    String          @db.Uuid
  type       TransactionType
  amount     Decimal         @db.Decimal(15, 2)
  category   String
  note       String?
  date       DateTime        @default(now()) @db.Timestamptz(6)
  image_url  String?
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @db.Timestamptz(6)
  book       Book            @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  income
  expense
}

model MonthlyBudget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  book_id    String   @db.Uuid
  month      String   @db.VarChar(7)
  amount     Decimal  @db.Decimal(15, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  book       Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)

  @@unique([book_id, month])
  @@map("monthly_budgets")
}

model UserSettings {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @unique @db.Uuid
  default_book_id String?  @db.Uuid
  notifications   Json     @default("{\"transactions\": true, \"books\": true, \"reports\": false, \"email\": true}")
  export_format   String   @default("csv") @db.VarChar(10)
  currency        String   @default("USD") @db.VarChar(3)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("user_settings")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  title      String
  message    String
  type       NotificationType @default(info)
  read       Boolean          @default(false)
  metadata   Json?            @default("{}")
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @default(now()) @db.Timestamptz(6)

  @@map("notifications")
}

enum NotificationType {
  info
  success
  warning
  error
}
